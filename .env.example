# Application & Hosting
APP_URL="https://shop-itng-pied.vercel.app"
PORT=3000

# Neon PostgreSQL Database (Pooled connection string)
DATABASE_URL="postgres://user:password@ep-xyz.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Administrator Account Bootstrapping
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_INITIAL_PASSWORD="your-strong-initial-password"

# Upstash Redis / Vercel KV (Sessions, Rate limits, Lockouts)
KV_REST_API_URL="https://xyz.upstash.io"
KV_REST_API_TOKEN="AXyz..."

# Safety Switches (Default false: fail closed)
PAYMENTS_ENABLED="false"
PAYOUTS_ENABLED="false"
VITE_PAYMENTS_ENABLED="false"
VITE_PAYOUTS_ENABLED="false"

# Flutterwave API v3 Gateway & Transfers
FLW_PUBLIC_KEY="FLWPUBK_TEST-..."
FLW_SECRET_KEY="FLWSECK_TEST-..."
FLW_WEBHOOK_SECRET_HASH="your-random-32-char-webhook-secret-hash"
VITE_FLW_PUBLIC_KEY="FLWPUBK_TEST-..."

# Security & Encryption Secrets (Generate unique 32+ char random strings for production)
OTP_HASH_SALT=""
NIN_HASH_SALT=""
DOC_TOKEN_SECRET=""
DOC_ENCRYPTION_KEY=""
CRON_SECRET=""
ALLOWED_ORIGINS="https://shop-itng-pied.vercel.app"

# Brevo Transactional Email Service
EMAIL_FROM="shopitverified@gmail.com"
EMAIL_FROM_NAME="Shop It"
BREVO_API_KEY=""

# Sentry Error Monitoring
VITE_SENTRY_DSN=""

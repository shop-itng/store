# ==============================================================================
# SHOP IT ENVIRONMENT VARIABLES (Vercel Serverless & Production)
# ==============================================================================

# Brevo Transactional Email Service (POST https://api.brevo.com/v3/smtp/email)
EMAIL_FROM="shopitverified@gmail.com"
EMAIL_FROM_NAME="Shop It"
BREVO_API_KEY="xkeysib-..."

# Application URL (Configured for your Vercel deployment)
APP_URL="https://shop-itng-pied.vercel.app"

# Paystack Payment Gateway & Transfers
PAYSTACK_PUBLIC_KEY="pk_live_..."
PAYSTACK_SECRET_KEY="sk_live_..."
PAYSTACK_WEBHOOK_SECRET="sk_live_..."

# Optional Database Storage for Serverless Persistence (Vercel KV / Upstash Redis / Postgres)
# If not provided, persistent file storage is used (/tmp/shopit_otp_db.json)
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
POSTGRES_URL=""

# Local dev server port
PORT=3000

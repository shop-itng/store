{
  "version": 2,
  "buildCommand": "npm run build",
  "installCommand": "npm install --legacy-peer-deps",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/webhooks/flutterwave",
      "destination": "/api/webhooks/flutterwave"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
  { "path": "/api/cron/escrow", "schedule": "0 3 * * *" }
  ]
}
